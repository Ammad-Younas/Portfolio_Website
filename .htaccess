RewriteEngine On

# Custom route for course player
RewriteRule ^src/courses/course/([^/]+)/?$ src/courses/player/player.php?course=$1 [L,QSA]

# Route extensionless requests to .php files if they exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ includes/404.php [L,QSA]
